// Eventini — Prisma schema.
//
// Authoritative reference: docs/database/DATABASE_SCHEMA.md.
//
// Covers migrations 1 (identity_core), 2 (authorization_core), 3 (events_core)
// and 8 (audit_and_security). The remaining ten arrive with their sprints.
//
// Migration 8 is out of numeric order on purpose — invariant O-3 requires the
// audit trail to exist before the first business write, because an untraced
// operation cannot be traced retroactively.
//
// ## Conventions this file follows, and why (DATABASE_SCHEMA.md §2)
//
// - Identifiers are TEXT holding a prefixed UUID v7 (`usr_`, `org_`, …),
//   generated by the application. Never SERIAL: a sequential id is
//   enumerable, which hands out both IDOR targets and the activity volume.
// - Every timestamp is TIMESTAMPTZ. A `TIMESTAMP` silently drops the offset,
//   and check-in windows are computed in the event's timezone rather than the
//   server's.
// - Enum-valued columns are `String` here, TEXT + a named CHECK constraint in
//   SQL. This is deliberate and costs something, so the reasoning matters: a
//   Prisma `enum` compiles to `CREATE TYPE ... AS ENUM`, and a native
//   PostgreSQL enum can gain a value but cannot lose one without rewriting
//   the table — verified by generating the migration and reading it.
//   DATABASE_SCHEMA.md §2.2 forbids it for exactly that reason. The type
//   safety a Prisma enum would have given is recovered in TypeScript, in
//   src/infrastructure/database/enums.ts, which is also where the CHECK's
//   allowed values are declared once so the two cannot drift.
// - Unique indexes on soft-deleted tables are PARTIAL (`WHERE deleted_at IS
//   NULL`), so a deleted row does not reserve its email or slug forever.
//   Prisma's schema language cannot express a partial index, so those live in
//   the migration SQL and are deliberately absent here — see the note on each
//   model.

generator client {
  // Prisma 7's generator is `prisma-client`, not the `prisma-client-js` of
  // earlier majors, and `output` is required rather than defaulting into
  // node_modules.
  provider = "prisma-client"

  // CommonJS output. The generator defaults to ESM and emits
  // `import.meta.url`, which this backend cannot load: package.json has no
  // "type": "module", so ts-jest and `node dist/main` both run CommonJS and
  // fail with "Cannot use 'import.meta' outside a module". Found by the unit
  // suite refusing to load the client at all.
  moduleFormat = "cjs"

  // Extensionless relative imports inside the generated client.
  //
  // The generator's default is `.js` — the NodeNext convention, where a `.ts`
  // file imports its sibling as `./thing.js` because that is what it will be
  // after compilation. TypeScript understands that; Node's CommonJS resolver,
  // running the sources directly, does not: it looks for a literal
  // `internal/class.js`, finds only `internal/class.ts`, and throws
  // MODULE_NOT_FOUND. That is what `ts-node prisma/seed/index.ts` hits, and
  // what Jest was papering over with a `moduleNameMapper` rewrite in three
  // separate configurations.
  //
  // `""` emits `require('./internal/class')`, which the CommonJS resolver
  // handles natively and which stays correct after compilation. It fixes the
  // cause rather than each tool that trips over it.
  importFileExtension = ""

  output   = "../src/infrastructure/database/prisma/generated"
}

datasource db {
  provider = "postgresql"
  // No `url` here on purpose: Prisma 7 reads it from prisma.config.ts.
}

// ---------------------------------------------------------------------------
// Migration 1 — identity_core
// ---------------------------------------------------------------------------

/// Platform-wide identity. PLATFORM-owned, SOFT_DELETE.
///
/// Deliberately carries no `organizationId`, `role` or `permissions`:
/// membership runs exclusively through OrganizationMembership, which is what
/// makes one user belonging to several organizations possible at all.
model User {
  id String @id

  /// As typed by the user; shown back to them.
  primaryEmail String @map("primary_email")

  /// Lowercased, trimmed, NFKC-normalised. This is what uniqueness and rate
  /// limiting key on — comparing raw input would let `A@x.com` and `a@x.com`
  /// register twice and would let a login attempt dodge the per-email limiter
  /// by changing case.
  normalizedEmail String @map("normalized_email")

  firstName   String  @map("first_name")
  lastName    String  @map("last_name")
  displayName String? @map("display_name")

  /// One of UserStatus (enums.ts). TEXT + ck_users_status in SQL.
  status String

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)

  /// BCP 47.
  locale String?
  /// IANA.
  timezone String?

  /// Bumped on any email, status or password change. Access tokens carry it
  /// as the `ver` claim, so incrementing it invalidates every token already
  /// in circulation without a revocation list (ADR-0004, chain step 3).
  /// Distinct from `UserCredential.passwordVersion` — see §11's four versions.
  version Int @default(1)

  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?   @map("deleted_by")
  deletionReason String?   @map("deletion_reason")

  credential              UserCredential?
  memberships             OrganizationMembership[]
  platformRoleAssignments PlatformRoleAssignment[]

  // `ux_users_normalized_email_active` is partial (WHERE deleted_at IS NULL)
  // and therefore lives in the migration SQL; Prisma cannot express it.
  @@index([status], map: "ix_users_status")
  @@index([createdAt(sort: Desc)], map: "ix_users_created_at")
  @@map("users")
}

/// The authentication secret, kept in its own table. PLATFORM-owned; the row
/// follows its user rather than being soft-deleted independently.
///
/// Separate from User for one specific reason: reading a profile must never
/// return the hash. Splitting the tables makes that structurally impossible
/// instead of dependent on every query remembering the right `select`.
model UserCredential {
  id     String @id
  userId String @unique @map("user_id")

  /// Argon2id, encoded form (ADR-0007). Never leaves the infrastructure
  /// layer — not in a response, not in a log (redacted per Document D §30).
  passwordHash String @map("password_hash")

  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)

  /// Which Argon2id parameter profile produced `passwordHash`. `1` is
  /// m=19456, t=2, p=1. A value below the current profile triggers a
  /// transparent rehash on the next successful verification, which is how
  /// parameters are raised over time without forcing a password reset.
  passwordVersion Int @default(1) @map("password_version")

  mustChangePassword Boolean @default(false) @map("must_change_password")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Cascade: the credential has no meaning without its user, and leaving an
  // orphaned password hash behind is strictly worse than deleting it.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // No createdBy/updatedBy: the actor is always the user themselves, or a
  // reset already recorded in security_events.
  @@map("user_credentials")
}

/// The tenant. PLATFORM-owned, SOFT_DELETE.
model Organization {
  id     String @id
  name   String
  slug   String
  /// One of OrganizationStatus (enums.ts). TEXT + ck_organizations_status.
  status String

  licensePlan String @map("license_plan")

  /// NULL means unlimited.
  userLimit  Int? @map("user_limit")
  eventLimit Int? @map("event_limit")

  /// Immediate kill switch, deliberately independent of `status`. Both are
  /// checked at step 4 of the authorization chain. `isEnabled = false` cuts
  /// access in one write and is reversible; `KILLED` is the durable state
  /// transition. The project context warns against a boolean standing in for
  /// a business state — here the two coexist with different jobs, which is
  /// the exception it allows when made explicit.
  isEnabled Boolean @default(true) @map("is_enabled")

  version Int @default(1)

  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?   @map("deleted_by")
  deletionReason String?   @map("deletion_reason")

  memberships OrganizationMembership[]
  events      Event[]

  // `ux_organizations_slug_active` is partial; see the migration SQL.
  @@index([status], map: "ix_organizations_status")
  @@index([isEnabled], map: "ix_organizations_is_enabled")
  @@map("organizations")
}

/// The user ↔ organization link, and the pivot of the whole multi-tenant
/// model. ORGANIZATION-owned, SOFT_DELETE.
model OrganizationMembership {
  id             String @id
  userId         String @map("user_id")
  organizationId String @map("organization_id")

  /// One of MembershipStatus (enums.ts). TEXT + ck_memberships_status.
  status String

  joinedAt  DateTime? @map("joined_at") @db.Timestamptz(3)
  invitedBy String?   @map("invited_by")

  activatedAt DateTime? @map("activated_at") @db.Timestamptz(3)
  activatedBy String?   @map("activated_by")

  suspendedAt      DateTime? @map("suspended_at") @db.Timestamptz(3)
  suspendedBy      String?   @map("suspended_by")
  suspensionReason String?   @map("suspension_reason")

  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy        String?   @map("revoked_by")
  revocationReason String?   @map("revocation_reason")

  version Int @default(1)

  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?   @map("deleted_by")
  deletionReason String?   @map("deletion_reason")

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  roleAssignments  MembershipRoleAssignment[]
  eventAssignments EventUserAssignment[]

  // `ux_membership_user_org_active` is partial; see the migration SQL.
  // Tenant-first ordering on every index (§2.6): `organization_id` appears in
  // every tenant-scoped query, so an index that does not lead with it cannot
  // serve one.
  @@index([organizationId, status], map: "ix_memberships_org_status")
  @@index([userId, status], map: "ix_memberships_user_status")
  @@index([organizationId, createdAt(sort: Desc)], map: "ix_memberships_org_created")
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Migration 2 — authorization_core
// ---------------------------------------------------------------------------

/// GLOBAL-REFERENCE: seeded, never written at runtime, never deleted.
model Role {
  id          String    @id
  code        String    @unique(map: "ux_roles_code")
  name        String
  /// One of RoleScope (enums.ts). TEXT + ck_roles_scope.
  scope       String
  description String?

  /// A system role is part of the product and cannot be edited away by an
  /// administrator.
  isSystem Boolean @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions             RolePermission[]
  membershipAssignments   MembershipRoleAssignment[]
  platformRoleAssignments PlatformRoleAssignment[]

  @@index([scope], map: "ix_roles_scope")
  @@index([isSystem], map: "ix_roles_system")
  @@map("roles")
}

/// GLOBAL-REFERENCE. Codes follow `resource.action`, lowercase, snake_case
/// for compound actions.
model Permission {
  id          String  @id
  code        String  @unique(map: "ux_permissions_code")
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([resource, action], map: "ix_permissions_resource_action")
  @@map("permissions")
}

/// GLOBAL-REFERENCE. Replaced wholesale by the seed rather than edited.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  // Reverse direction, to answer "which roles carry this permission" without
  // scanning: the composite primary key already serves the forward question.
  @@index([permissionId, roleId], map: "ix_role_permissions_permission")
  @@map("role_permissions")
}

/// A role granted within one organization, through a membership.
/// ORGANIZATION-owned, REVOKE_NOT_DELETE.
model MembershipRoleAssignment {
  id           String @id
  membershipId String @map("membership_id")
  roleId       String @map("role_id")

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedBy String?  @map("assigned_by")

  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy        String?   @map("revoked_by")
  revocationReason String?   @map("revocation_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership OrganizationMembership @relation(fields: [membershipId], references: [id])
  role       Role                   @relation(fields: [roleId], references: [id])

  // `ux_membership_role_active` is partial (WHERE revoked_at IS NULL) and
  // lives in the migration SQL.
  //
  // A PLATFORM-scoped role must never appear here — that is the most direct
  // privilege-escalation path in the model, so it is enforced by a database
  // trigger as well as in application code (INV-09). Application-only
  // enforcement is not an invariant, it is a convention.
  @@index([membershipId, revokedAt], map: "ix_membership_roles_membership")
  @@index([roleId, revokedAt], map: "ix_membership_roles_role")
  @@map("membership_role_assignments")
}

/// A platform-wide role, granted directly to a user with no organization in
/// between. PLATFORM-owned, REVOKE_NOT_DELETE.
model PlatformRoleAssignment {
  id     String @id
  userId String @map("user_id")
  roleId String @map("role_id")

  /// One of PlatformRoleAssignmentStatus (enums.ts). TEXT + ck_platform_role_assignments_status.
  status String

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedBy String?  @map("assigned_by")

  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy        String?   @map("revoked_by")
  revocationReason String?   @map("revocation_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  // `ux_platform_role_user_active` is partial; see the migration SQL.
  @@index([userId, status], map: "ix_platform_roles_user_status")
  @@index([roleId, status], map: "ix_platform_roles_role_status")
  @@map("platform_role_assignments")
}

// ---------------------------------------------------------------------------
// Migration 3 — events_core
// ---------------------------------------------------------------------------

/// An event. ORGANIZATION-owned, SOFT_DELETE.
///
/// This table was a phantom in the corpus (contradiction C-10): three foreign
/// keys pointed at it while it had no column definition, no status enum and no
/// index anywhere. DATABASE_SCHEMA.md §6.1 defines it; this is that definition.
model Event {
  id             String @id
  organizationId String @map("organization_id")

  name String
  /// Unique per organization, not globally — two tenants may each run a
  /// "summit-2026".
  slug        String
  description String?

  /// One of EventStatus (enums.ts). TEXT + ck_events_status.
  status String

  /// The short code a scanner types to bind itself to an event.
  ///
  /// Unique GLOBALLY rather than per organization, which looks like a
  /// tenant-first violation and is not: the scanner enters it *before* any
  /// tenant is known, so it is the value that resolves the tenant. That is
  /// precisely why it must be unpredictable — 8 characters of Crockford
  /// base32 from a CSPRNG, never sequential. A guessable code would let
  /// someone bind a scanner to another organization's event.
  eventCode String @map("event_code")

  /// IANA. Mandatory because check-in windows are evaluated in the event's
  /// timezone, not the server's — an event in Tunis and one in Montreal do
  /// not share a definition of "9am".
  timezone String

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// NULL follows startsAt / endsAt.
  checkInOpensAt  DateTime? @map("check_in_opens_at") @db.Timestamptz(3)
  checkInClosesAt DateTime? @map("check_in_closes_at") @db.Timestamptz(3)

  /// NULL means unlimited.
  capacity     Int?
  locationName String? @map("location_name")

  /// Non-structural business settings. JSONB with no GIN index at MVP — §10
  /// adds one only against a measured query need.
  settings Json @default("{}")

  activatedAt DateTime? @map("activated_at") @db.Timestamptz(3)
  activatedBy String?   @map("activated_by")

  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy        String?   @map("cancelled_by")
  cancellationReason String?   @map("cancellation_reason")

  expiredAt DateTime? @map("expired_at") @db.Timestamptz(3)

  /// Optimistic lock, exposed as an ETag: an event is edited concurrently by
  /// several administrators.
  version Int @default(1)

  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?   @map("deleted_by")
  deletionReason String?   @map("deletion_reason")

  organization Organization          @relation(fields: [organizationId], references: [id])
  sessions     EventSession[]
  assignments  EventUserAssignment[]

  // ux_events_org_slug_active and ux_events_event_code_active are partial and
  // live in the migration SQL.
  @@index([organizationId, status], map: "ix_events_org_status")
  @@index([organizationId, startsAt(sort: Desc)], map: "ix_events_org_starts_at")
  @@index([status, checkInOpensAt, checkInClosesAt], map: "ix_events_status_check_in")
  @@map("events")
}

/// A subdivision of an event — a day, panel, workshop, zone or slot.
/// EVENT-owned, SOFT_DELETE.
model EventSession {
  id String @id

  /// Denormalised from events, and not an optimisation. §2.4: it is what lets
  /// the tenant-isolation extension (ADR-0003, EVT-018) check scope WITHOUT a
  /// join. Without this column the guard would have to understand the
  /// relational graph, so it would be partial, so it would be bypassable.
  /// INV-04 keeps it equal to events.organization_id, by trigger.
  organizationId String @map("organization_id")
  eventId        String @map("event_id")

  name String

  /// One of EventSessionType (enums.ts). TEXT + ck_event_sessions_type.
  sessionType String @map("session_type")
  /// One of EventSessionStatus (enums.ts). TEXT + ck_event_sessions_status.
  status String

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  checkInOpensAt  DateTime? @map("check_in_opens_at") @db.Timestamptz(3)
  checkInClosesAt DateTime? @map("check_in_closes_at") @db.Timestamptz(3)

  capacity     Int?
  locationName String? @map("location_name")

  /// Whether attending this session needs its own check-in, or the
  /// event-level one suffices.
  requiresSeparateCheckIn Boolean @default(true) @map("requires_separate_check_in")

  openedAt DateTime? @map("opened_at") @db.Timestamptz(3)
  openedBy String?   @map("opened_by")
  closedAt DateTime? @map("closed_at") @db.Timestamptz(3)
  closedBy String?   @map("closed_by")

  version Int @default(1)

  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?   @map("deleted_by")
  deletionReason String?   @map("deletion_reason")

  event Event @relation(fields: [eventId], references: [id])

  // ix_event_sessions_open_window is partial (WHERE status='OPEN') and lives
  // in the migration SQL.
  @@index([organizationId, eventId], map: "ix_event_sessions_org_event")
  @@index([eventId, status], map: "ix_event_sessions_event_status")
  @@index([eventId, startsAt], map: "ix_event_sessions_event_starts")
  @@map("event_sessions")
}

/// Who may act on an event, and in what capacity. EVENT-owned,
/// REVOKE_NOT_DELETE.
model EventUserAssignment {
  id String @id

  /// Denormalised, as on event_sessions. INV-01 keeps it equal to BOTH
  /// events.organization_id and organization_memberships.organization_id — a
  /// cross-tenant assignment is otherwise expressible.
  organizationId String @map("organization_id")
  eventId        String @map("event_id")
  membershipId   String @map("membership_id")

  /// One of EventAssignmentType (enums.ts), and NOT free text:
  /// ENTITY_RELATIONSHIPS.md §4.4 resolves event permissions by joining this
  /// against roles.code where roles.scope = 'EVENT'.
  assignmentType String @map("assignment_type")

  /// One of EventAssignmentStatus (enums.ts).
  status String

  /// An assignment outside its validity window grants NOTHING, even when it
  /// has not been revoked — §6.3. NULL on either side means unbounded.
  validFrom  DateTime? @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedBy String?  @map("assigned_by")

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy String?   @map("revoked_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event                  @relation(fields: [eventId], references: [id])
  membership OrganizationMembership @relation(fields: [membershipId], references: [id])

  // ux_event_assignment_active is partial (WHERE revoked_at IS NULL).
  @@index([membershipId, status], map: "ix_event_assignments_membership")
  @@index([eventId, status], map: "ix_event_assignments_event")
  @@index([organizationId, eventId], map: "ix_event_assignments_org_event")
  @@map("event_user_assignments")
}

// ---------------------------------------------------------------------------
// Migration 8 — audit_and_security
//
// Applied in sprint 03 despite its rank, per invariant O-3: an untraced
// business operation is untraced permanently. Waiting until sprint 08 would
// leave everything sprints 04-07 create — account creation, role assignment,
// exactly what an audit trail exists to cover — with no record, and the gap
// cannot be reconstructed afterwards.
// ---------------------------------------------------------------------------

/// Security-relevant occurrences. Mixed ownership, APPEND_ONLY, 12-month
/// retention.
///
/// Not the same thing as a Pino log line, and the distinction is the point of
/// having both (logging spec §3.5, §5). A log is diagnostic, lives in a log
/// store, and is retained for weeks; this is evidence, lives in PostgreSQL
/// alongside the data it describes, and is queried during an incident or an
/// audit. Conflating the two retentions is contradiction C-15.
model SecurityEvent {
  id String @id

  /// One of SecurityEventType (enums.ts) — the union of the corpus's four
  /// competing catalogues (C-11). TEXT + ck_security_events_type.
  eventType String @map("event_type")

  /// One of SecurityEventSeverity (enums.ts).
  severity String
  /// One of SecurityEventResult (enums.ts).
  result String

  /// Why, in machine-readable form. Free text rather than an enum: the reason
  /// space grows with every feature, and an over-tight CHECK here would push
  /// callers into recording nothing.
  reasonCode String? @map("reason_code")

  /// Every actor field is nullable because a security event can precede
  /// identity entirely — a failed login has no user, an origin rejection has
  /// no session, and a platform action has no organization.
  userId         String? @map("user_id")
  sessionId      String? @map("session_id")
  organizationId String? @map("organization_id")
  membershipId   String? @map("membership_id")
  deviceId       String? @map("device_id")

  /// Correlation back to the request and its trace, so an event here can be
  /// joined to the log line and the trace span that produced it.
  requestId String? @map("request_id")
  traceId   String? @map("trace_id")

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  /// Allowed keys are listed in AUTHENTICATION_AUTHORIZATION.md §8. Never a
  /// password, token, cookie, MFA secret, recovery code or QR payload — §8's
  /// "jamais journalisé" list applies here exactly as it does to logs.
  metadata Json @default("{}")

  /// When it happened, which is not when the row was written: an event
  /// recorded from a queued job or an offline scanner sync can land long
  /// after the fact, and analysis needs the former.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // The four partial indexes live in the migration SQL.
  @@index([eventType, occurredAt(sort: Desc)], map: "ix_security_events_type_time")
  @@index([severity, occurredAt(sort: Desc)], map: "ix_security_events_severity_time")
  @@map("security_events")
}

/// Who did what to which resource. Mixed ownership, APPEND_ONLY, retention
/// per business obligation.
///
/// Separate from `security_events` because they answer different questions: a
/// security event asks "was something attacked or refused", an audit entry
/// asks "who changed this record, and from what to what".
model AuditLog {
  id String @id

  actorUserId    String? @map("actor_user_id")
  actorSessionId String? @map("actor_session_id")

  /// A TEXTUAL SNAPSHOT of the role at the moment of the action, not a
  /// foreign key. That is deliberate: a FK would make the audit trail change
  /// retroactively when the role is renamed, revoked or deleted, so the
  /// record of what someone was permitted to do would be rewritten by later
  /// events. An audit trail that changes after the fact is not one.
  actorRole String? @map("actor_role")

  organizationId String? @map("organization_id")

  targetType String  @map("target_type")
  targetId   String? @map("target_id")
  action     String

  /// Before and after. Sensitive fields are replaced with "[REDACTED]" and
  /// NEVER omitted — omission would hide the fact that they changed at all,
  /// which is precisely what an auditor is looking for. See
  /// `audit-redaction.ts`.
  previousValues Json? @map("previous_values")
  newValues      Json? @map("new_values")

  /// Free-text justification, where the operation asked for one.
  reason String?

  requestId String? @map("request_id")
  ipAddress String? @map("ip_address") @db.Inet

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([organizationId, occurredAt(sort: Desc)], map: "ix_audit_org_time")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "ix_audit_actor_time")
  @@index([targetType, targetId, occurredAt(sort: Desc)], map: "ix_audit_target")
  @@index([action, occurredAt(sort: Desc)], map: "ix_audit_action_time")
  @@map("audit_logs")
}
