# =============================================================================
# Eventini backend — environment template
#
# Copy to .env and fill in. Every secret below is a PLACEHOLDER that the
# application refuses to start with (cross rule 9): each decodes to the marker
# EXAMPLE-DO-NOT-USE, and the startup check reports it by name.
#
# Placeholders are deliberately long enough to satisfy the 32-byte entropy rule,
# so "you shipped the example file" is reported as exactly that, rather than as
# a misleading complaint about entropy.
#
# Fastest path for local development:
#     node scripts/generate-dev-env.mjs
# which writes a complete .env with freshly generated keys and secrets.
#
# Reference: docs/operations/ENVIRONMENT_VARIABLES.md
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# 3001, not 3000: 3000 is the Next.js dev server.
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
# A hop count, NEVER true. With true, anyone can forge X-Forwarded-For and
# bypass every IP-based rate limit.
TRUSTED_PROXY_HOPS=1
SHUTDOWN_TIMEOUT_MS=15000
SWAGGER_ENABLED=true

# --- PostgreSQL --------------------------------------------------------------
# Host port is 5433, not 5432 (docker-compose offsets it).
DATABASE_URL=postgresql://eventini:eventini@localhost:5433/eventini?schema=public
SHADOW_DATABASE_URL=postgresql://eventini:eventini@localhost:5433/eventini_shadow?schema=public
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_SLOW_QUERY_THRESHOLD_MS=500

# --- Redis -------------------------------------------------------------------
# Host port is 6380, not 6379.
REDIS_URL=redis://:eventini@localhost:6380/0
REDIS_QUEUE_DB=1
REDIS_PUBSUB_DB=2
REDIS_TLS_ENABLED=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3

# --- Cryptography ------------------------------------------------------------
# ALL PLACEHOLDERS. The application refuses to start until each is replaced.
#
#   symmetric secret:  openssl rand -base64 32
#   Ed25519 key pair:  openssl genpkey -algorithm ed25519 -out key.pem
#                      openssl pkey -in key.pem -pubout -out pub.pem
#                      then base64-encode each PEM
#
# The seven symmetric secrets are INDEPENDENT. Reusing one for another is
# refused (rule 8): key separation is the whole point.

ACCESS_TOKEN_PRIVATE_KEY=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U
ACCESS_TOKEN_PUBLIC_KEY=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U
ACCESS_TOKEN_KEY_ID=ak_2026_07
ACCESS_TOKEN_ISSUER=http://localhost:3001
ACCESS_TOKEN_AUDIENCE_WEB=eventini-web
ACCESS_TOKEN_AUDIENCE_SCANNER=eventini-scanner
# Set only during a key rotation overlap window (ADR-0005).
# ACCESS_TOKEN_PREVIOUS_PUBLIC_KEY=
# ACCESS_TOKEN_PREVIOUS_KEY_ID=

REFRESH_TOKEN_HMAC_SECRET=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U
CSRF_SECRET=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U
MFA_ENCRYPTION_KEY=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U
INVITATION_TOKEN_SECRET=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U
PASSWORD_RESET_TOKEN_SECRET=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U
COOKIE_SECRET=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U

QR_SIGNING_PRIVATE_KEY=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U
QR_SIGNING_PUBLIC_KEY=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U
QR_SIGNING_KEY_ID=qr_2026_07

# CRITICAL BACKUP ITEM. Losing PASSWORD_PEPPER makes every stored password
# unverifiable — no user can log in and no database restore fixes it. Back it up
# alongside the database, and separately from it.
PASSWORD_PEPPER=RVhBTVBMRS1ETy1OT1QtVVNFLVJFUExBQ0UtQkVGT1JFLUFOWS1ERVBMT1lNRU5U

# --- Authentication ----------------------------------------------------------
# Configurable, but NOT free-tuning knobs. Read ADR-0007 and ADR-0009 first;
# changing these changes the security posture.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

ACCESS_TOKEN_TTL_WEB_ADMIN=10m
ACCESS_TOKEN_TTL_WEB_SUPER_ADMIN=5m
ACCESS_TOKEN_TTL_SCANNER=15m
REFRESH_TOKEN_TTL_WEB_ADMIN=14d
REFRESH_TOKEN_TTL_WEB_SUPER_ADMIN=1d
REFRESH_TOKEN_TTL_SCANNER=30d
SESSION_IDLE_TTL_WEB_ADMIN=12h
SESSION_IDLE_TTL_WEB_SUPER_ADMIN=30m
SESSION_IDLE_TTL_SCANNER=7d
SESSION_ABSOLUTE_TTL_WEB_ADMIN=30d
SESSION_ABSOLUTE_TTL_WEB_SUPER_ADMIN=7d
SESSION_ABSOLUTE_TTL_SCANNER=90d

PASSWORD_RESET_TTL=30m
EMAIL_VERIFICATION_TTL=24h
INVITATION_TTL=7d
MFA_CHALLENGE_TTL=5m
MFA_CHALLENGE_MAX_ATTEMPTS=5
REAUTHENTICATION_TTL=10m
TOTP_DIGITS=6
TOTP_PERIOD_SECONDS=30
TOTP_DRIFT_WINDOWS=1
RECOVERY_CODE_COUNT=10
JWT_CLOCK_TOLERANCE_SECONDS=30

# --- Cookies and CSRF --------------------------------------------------------
COOKIE_ACCESS_NAME=__Host-eventini_access
COOKIE_REFRESH_NAME=__Secure-eventini_refresh
COOKIE_CSRF_NAME=__Host-eventini_csrf
COOKIE_CSRF_CONTEXT_NAME=__Host-eventini_csrf_ctx
COOKIE_REFRESH_PATH=/api/v1/auth/sessions
# 🔴 true even in local development, and the four names above are why.
#
# A cookie whose name carries the __Host- or __Secure- prefix is DISCARDED by
# the browser unless it is set with the Secure attribute. With false here, all
# four cookies were silently dropped: /auth/csrf-token answered 200, no cookie
# was stored, the client sent no X-CSRF-Token, and every local login failed
# with 403 AUTH_CSRF_INVALID — using entirely valid credentials.
#
# Browsers treat http://localhost as a trustworthy origin and accept Secure
# cookies on it, so true costs nothing locally. Keeping it true also keeps the
# cookie names identical to production, so a name-related bug cannot appear
# only there.
#
# `cookie-prefix.rule.ts` now refuses to start on the broken combination.
# Dropping the prefixes instead is the other valid option — see that file.
COOKIE_SECURE=true
COOKIE_SAMESITE_ACCESS=lax
COOKIE_SAMESITE_REFRESH=strict
CSRF_CONTEXT_TTL=30m

# --- CORS --------------------------------------------------------------------
# Exact origins, comma separated. No wildcard, no pattern. Production requires
# https:// only.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_MAX_AGE_SECONDS=600

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_GLOBAL_IP=300
RATE_LIMIT_GLOBAL_USER=1000
RATE_LIMIT_GLOBAL_ORG=5000
RATE_LIMIT_LOGIN_IP_EMAIL=5
RATE_LIMIT_LOGIN_IP_EMAIL_WINDOW=15m
RATE_LIMIT_LOGIN_IP=20
RATE_LIMIT_MFA_VERIFY=5
RATE_LIMIT_REFRESH=30
RATE_LIMIT_PASSWORD_RESET_EMAIL=3
RATE_LIMIT_CHECKIN_DEVICE=600
# Keyed on ip+email, never email alone — see ADR-0013.
LOCKOUT_THRESHOLDS=5,10,15
LOCKOUT_DURATIONS=15m,1h,24h
RATE_LIMIT_FAIL_MODE_AUTH=closed
RATE_LIMIT_FAIL_MODE_OTHER=open

# --- Resource limits ---------------------------------------------------------
BODY_LIMIT_JSON=100kb
BODY_LIMIT_IMPORT=10mb
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
SEARCH_MIN_LENGTH=2
SEARCH_MAX_LENGTH=100
IMPORT_MAX_ROWS=50000
ATTENDANCE_SYNC_MAX_OPERATIONS=500
JOB_MAX_CONCURRENT_PER_ORG=3
JOB_TIMEOUT_MS=900000
JOB_MAX_ATTEMPTS=5
IDEMPOTENCY_RETENTION=24h
# Longer for attendance: a scanner can stay offline for a whole multi-day event,
# and 24h would turn a legitimate replay into a duplicate check-in.
IDEMPOTENCY_RETENTION_ATTENDANCE=7d
QR_REPLAY_WINDOW_SECONDS=90
SSE_MAX_CONNECTIONS_PER_USER=10

# --- Email -------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=eventini
SMTP_PASSWORD=eventini
SMTP_SECURE=false
MAIL_FROM_ADDRESS=no-reply@eventini.local
MAIL_FROM_NAME=Eventini
# MAIL_REPLY_TO=

# --- Observability -----------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_PRETTY=true
LOG_SERVICE_NAME=eventini-api
LOG_SERVICE_VERSION=0.0.1
# Never false in staging or production; the check refuses it.
LOG_REDACTION_ENABLED=true
LOG_HTTP_ENABLED=true
LOG_HTTP_SUCCESS_ENABLED=true
LOG_SLOW_REQUEST_THRESHOLD_MS=1000
LOG_SLOW_QUERY_THRESHOLD_MS=500
# LOG_DEBUG_MODULES=identity,sessions,redis
# LOG_DEBUG_EXPIRES_AT=2026-07-31T02:00:00Z
METRICS_ENABLED=true
METRICS_PATH=/metrics
# INSTANCE_ID=

# --- Bootstrap ---------------------------------------------------------------
# The first SUPER_ADMIN is created PENDING and WITHOUT a password; a one-time
# verification token is printed once. No password is ever put in a seed.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@eventini.local
# Refused when NODE_ENV=production.
SEED_DEMO_DATA=true
