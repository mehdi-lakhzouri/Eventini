# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template must be committed: it is the only record of which variables a
# fresh clone needs. The create-next-app default `.env*` swallowed it, so
# web/.env.example could never have been added — the same class of gap that
# left docker/.env.example empty and unusable.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
