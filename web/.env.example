# =============================================================================
# Eventini web — environment template
#
# Copy to .env.local and adjust.
# Reference: docs/operations/ENVIRONMENT_VARIABLES.md §14
# =============================================================================

# EVERYTHING prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and is
# visible to every visitor. No secret may ever carry this prefix.
#
# The frontend needs no secret at all: authentication rides on HttpOnly cookies
# set by the backend, and no token is ever readable from JavaScript
# (AUTH-INV-001).

# Must point at 3001. The previous default was 3000 — the Next.js dev server's
# own port — so the app called itself and every API request 404'd
# (FRONTEND_ARCHITECTURE.md F-5).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

NEXT_PUBLIC_APP_URL=http://localhost:3000

# fr is the default locale (ADR-0001). Full i18n lands in EVT-047.
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Shows an environment banner outside production.
NEXT_PUBLIC_ENVIRONMENT=development
