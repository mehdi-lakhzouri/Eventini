# Copy to `.env` and fill in. `.env` is git-ignored.
#
# POSTGRES_USER, POSTGRES_PASSWORD and REDIS_PASSWORD are interpolated into
# DATABASE_URL and REDIS_URL in docker-compose.yml. Both the `pg` and `redis`
# URL parsers split on the LAST `@`, so an `@` in a value is tolerated — but
# `/`, `?` and `#` are not, because each terminates a URL component. Keep
# these values free of those three characters, or percent-encode them.

POSTGRES_USER=eventini
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=eventini
POSTGRES_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-strong-password
PGADMIN_PORT=5051

REDIS_PASSWORD=change-me-strong-password
REDIS_PORT=6380

# Host ports for the two application containers (EVT-013). The containers
# themselves always listen on 3001 and 3000; these only decide what the host
# publishes, so change them if something local already holds the port.
API_PORT=3001
WEB_PORT=3000
